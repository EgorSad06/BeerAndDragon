<Project Sdk="Microsoft.NET.Sdk">
  <!-- Проверка документации модуля ObjectPool (ПЗ-2): модуль собирается отдельно от Unity (зависит только от System),
       компилятор генерирует XML-документацию; публичный член без комментария или неверная ссылка cref дают ошибку.
       Запуск: dotnet build tools/pz02/PoolDoc; результат: bin/.../PoolDoc.xml -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 нет комментария; CS1572/CS1573 параметры; CS1574/CS1584 битый cref; CS1587 комментарий не на месте -->
    <WarningsAsErrors>CS1591;CS1572;CS1573;CS1574;CS1584;CS1587</WarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Game/Scripts/Core/*.cs" />
  </ItemGroup>
</Project>
