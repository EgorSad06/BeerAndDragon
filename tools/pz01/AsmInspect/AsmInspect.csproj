<Project Sdk="Microsoft.NET.Sdk">
  <!-- Средство просмотра результата сборки (аналог ildasm и dumpbin /dependents) для ПЗ-1.
       Запуск: dotnet run project tools/pz01/AsmInspect, после разделителя путь к .dll или .exe -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Запуск на любой более новой среде .NET (9, 10, ...), если .NET 8 не установлена -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
</Project>
